{
  "title": "RCT-Engine SaaS Overview",
  "uid": "rct-saas-overview",
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "API Request Rate",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{
        "expr": "sum(rate(rct_api_requests_total[5m]))",
        "legendFormat": "requests/sec"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1000}
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Words Processed (Last 24h)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "targets": [{
        "expr": "sum(increase(rct_billing_words_total[24h]))",
        "format": "time_series"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "blue", "value": null}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Critical Blocks",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "targets": [{
        "expr": "sum(increase(rct_critical_blocks_total[24h]))"
      }],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 10},
              {"color": "red", "value": 50}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "P99 Latency",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0},
      "targets": [{
        "expr": "histogram_quantile(0.99, sum(rate(rct_api_request_duration_ms_bucket[5m])) by (le))"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 500},
              {"color": "red", "value": 1500}
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Risk by Country",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{
        "expr": "sum(rate(rct_critical_blocks_total[1h])) by (country)",
        "format": "table",
        "instant": true
      }],
      "options": {
        "pieType": "pie",
        "displayLabels": ["name", "value"]
      }
    },
    {
      "id": 6,
      "title": "Top Organizations by Usage",
      "type": "barchart",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{
        "expr": "topk(10, sum(increase(rct_billing_words_total[1h])) by (organization))",
        "format": "table",
        "instant": true
      }],
      "options": {
        "orientation": "horizontal",
        "xField": "organization",
        "yField": "Value"
      }
    },
    {
      "id": 7,
      "title": "Error Rate Heatmap",
      "type": "heatmap",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "targets": [{
        "expr": "sum(rate(rct_api_errors_total[1m])) by (status_code)",
        "format": "heatmap"
      }],
      "options": {
        "showLegend": true,
        "tooltip": {"show": true}
      }
    }
  ]
}
