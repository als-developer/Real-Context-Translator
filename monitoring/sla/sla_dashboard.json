{
  "title": "RCT-Engine SLA Dashboard",
  "uid": "sla-dashboard",
  "panels": [
    {
      "id": 1,
      "title": "Monthly Availability",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{
        "expr": "slo:api_availability:ratio_rate5m * 100",
        "format": "time_series"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 99,
          "max": 100,
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 99},
              {"color": "green", "value": 99.9}
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "P99 Latency",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{
        "expr": "histogram_quantile(0.99, sum(rate(rct_api_request_duration_ms_bucket[5m])) by (le))"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 100},
              {"color": "red", "value": 200}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Error Rate",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [{
        "expr": "sum(rate(rct_api_errors_total[5m])) / sum(rate(rct_api_requests_total[5m])) * 100"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 0.1},
              {"color": "red", "value": 1}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "SLA Compliance History",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "slo:api_availability:ratio_rate5m",
          "legendFormat": "Availability"
        },
        {
          "expr": "0.999",
          "legendFormat": "SLA Target (99.9%)",
          "color": "#F59E0B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 99,
          "max": 100
        }
      }
    },
    {
      "id": 5,
      "title": "SLO Burn Rate",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 16},
      "targets": [{
        "expr": "slo:api_availability:ratio_rate1h / 0.001"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "rate",
          "min": 0,
          "max": 20,
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 10},
              {"color": "red", "value": 15}
            ]
          }
        }
      }
    }
  ]
}
