# RCT-Engine Production Environment
# Copy to .env.production on production servers

ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=WARNING
SECRET_KEY=prod-8x9k2m4n6p8q0r2s4t6u8v0w2x4y6z8A

# Production Database (RDS)
DATABASE_URL=postgresql://rct_admin:${DB_PASSWORD}@rct-engine-prod.cluster-xxx.rds.amazonaws.com:5432/rct_saas
DATABASE_POOL_SIZE=100
DATABASE_MAX_OVERFLOW=200

# Production Redis (ElastiCache)
REDIS_URL=rediss://:${REDIS_PASSWORD}@rct-cache.xxx.cache.amazonaws.com:6379/0

# Production AI (with higher limits)
OPENAI_API_KEY=${OPENAI_API_KEY}
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=8192

# Production Stripe
STRIPE_SECRET_KEY=${STRIPE_SECRET_KEY}
STRIPE_WEBHOOK_SECRET=${STRIPE_WEBHOOK_SECRET}

# Production Alerts
SLACK_WEBHOOK_URL=${SLACK_WEBHOOK_URL}
PAGERDUTY_INTEGRATION_KEY=${PAGERDUTY_INTEGRATION_KEY}

# Production Security
JWT_EXPIRE_MINUTES=60
RATE_LIMIT_PER_SECOND=100
RATE_LIMIT_BURST=200
CORS_ORIGINS=["https://dashboard.rct-engine.com"]

# Production AWS
AWS_REGION=eu-west-1
AWS_S3_BUCKET_BACKUPS=rct-engine-backups-prod

# Production Feature Flags
ENABLE_AVX512=true
ENABLE_SLACK_ALERTS=true
ENABLE_PROMETHEUS_METRICS=true

# Production Tuning
API_WORKERS=8
API_THREADS=4
WORKER_CONCURRENCY=8
