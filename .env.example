# RCT-Engine Ultimate Environment Configuration
# Copy to .env or .env.production and fill in values

# ============================================
# Application Settings
# ============================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-please
API_VERSION=v1

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://rct_admin:password@localhost:5432/rct_saas
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_ECHO=false

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50

# ============================================
# AI Providers
# ============================================
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.3

CLAUDE_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-3-opus-20240229

# ============================================
# Stripe Billing
# ============================================
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# ============================================
# Monitoring & Alerts
# ============================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_ALERT_CHANNEL=#rct-alerts
PAGERDUTY_INTEGRATION_KEY=...
SENTRY_DSN=https://...

# ============================================
# Security
# ============================================
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=["https://dashboard.rct-engine.com","https://api.rct-engine.com"]
RATE_LIMIT_PER_SECOND=50
RATE_LIMIT_BURST=100

# ============================================
# AWS Configuration (for deployment)
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_S3_BUCKET_BACKUPS=rct-engine-backups
AWS_S3_BUCKET_ASSETS=rct-engine-assets

# ============================================
# Backup Encryption
# ============================================
BACKUP_ENCRYPTION_KEY=change-this-to-32-byte-key
BACKUP_RETENTION_DAYS=90
BACKUP_SCHEDULE="0 1 * * *"

# ============================================
# Feature Flags
# ============================================
ENABLE_BATCH_TRANSLATION=true
ENABLE_CULTURAL_CACHE=true
ENABLE_AVX512=true
ENABLE_SLACK_ALERTS=true
ENABLE_PROMETHEUS_METRICS=true

# ============================================
# Performance Tuning
# ============================================
API_WORKERS=4
API_THREADS=2
WORKER_CONCURRENCY=4
CELERY_TASK_TIME_LIMIT=1800
CELERY_SOFT_TIME_LIMIT=1500

# ============================================
# Compliance & Legal
# ============================================
GDPR_ENABLED=true
DATA_RETENTION_DAYS=90
AUDIT_LOG_ENABLED=true
COMPLIANCE_EMAIL=compliance@rct-engine.com
