# ============================================
# PayPal Configuration for RCT-Engine
# ============================================

# Mode: sandbox (testing) au live (production)
PAYPAL_MODE=sandbox

# PayPal API Credentials
# TAFADHALI: Usiweke credentials halisi kwenye faili za public!
# Tumia secrets manager au environment variables za server tu.
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_SECRET_KEY=your_sandbox_secret_key_here

# Webhook Configuration
PAYPAL_WEBHOOK_ID=your_webhook_id_here

# Return URLs
PAYPAL_RETURN_URL=https://dashboard.rct-engine.com/billing/success
PAYPAL_CANCEL_URL=https://dashboard.rct-engine.com/billing/cancel

# Sandbox Test Accounts (kwa ajili ya majaribio)
PAYPAL_SANDBOX_BUYER_EMAIL=sb-xxxxx@business.example.com
PAYPAL_SANDBOX_BUYER_PASSWORD=test123

# Live Production (kwa uzinduzi)
# PAYPAL_MODE=live
# PAYPAL_CLIENT_ID=your_live_client_id_here
# PAYPAL_SECRET_KEY=your_live_secret_key_here
